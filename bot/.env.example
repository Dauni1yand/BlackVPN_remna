# URL Remnawave-панели, доступный с главного сервера.
# После scripts/install-main-server.sh панель слушает 127.0.0.1:3000
# напрямую (в обход Caddy) — этого достаточно для CLI-скриптов ниже.
PANEL_URL=http://127.0.0.1:3000

# --- npm run bootstrap: супер-админ, API-токен, Config Profile ---
ADMIN_USERNAME=admin
# Если не задать — при первом запуске сгенерируется случайный пароль.
# Обязателен, если супер-админ уже создан и нужно просто перелогиниться.
# ADMIN_PASSWORD=
API_TOKEN_NAME=blackvpn-bot
API_TOKEN_EXPIRES_DAYS=3650
CONFIG_PROFILE_NAME=Default-Profile
REALITY_INBOUND_TAG=VLESS_REALITY
REALITY_PORT=443
REALITY_DEST=www.google.com:443
REALITY_SERVER_NAMES=www.google.com
INTERNAL_SQUAD_NAME=Default-Squad
OUT_FILE=./bootstrap-summary.json

# --- npm run add-node: регистрация новой ноды на панели ---
# API_TOKEN=              # можно не задавать, если рядом лежит bootstrap-summary.json
# BOOTSTRAP_SUMMARY_FILE=./bootstrap-summary.json
NODE_NAME=node-1
NODE_ADDRESS=203.0.113.10
NODE_CONTROL_PORT=2222
NODE_COUNTRY_CODE=XX

# --- npm run bot: сам Telegram-бот ---
BOT_TOKEN=123456:AA...                # от @BotFather
# Telegram user id (не username) через запятую — у кого есть доступ к
# "⚙️ Админ-панель". Свой id можно узнать, например, у @userinfobot.
ADMIN_TELEGRAM_IDS=123456789
# API_TOKEN и INTERNAL_SQUAD_UUID можно не задавать, если рядом лежит
# bootstrap-summary.json — бот возьмёт их оттуда сам.
# API_TOKEN=
# INTERNAL_SQUAD_UUID=
TRIAL_DAYS=3
TRIAL_TRAFFIC_GB=10
DB_PATH=./data/bot.sqlite3
