# URL Remnawave-панели, доступный с главного сервера.
# После scripts/install-main-server.sh панель слушает 127.0.0.1:3000
# напрямую (в обход Caddy) — этого достаточно для CLI-скриптов ниже.
PANEL_URL=http://127.0.0.1:3000

# --- npm run bootstrap: API-токен, id админов, Config Profile ---
# Remnawave не позволяет скриптам самим себе выписывать API-токен (это
# нарочно разрешено только из браузера) — поэтому его нужно создать самому:
# открой PANEL_URL в браузере, при первом заходе заведи супер-админа, затем
# Remnawave Settings -> API Tokens -> создать токен, и вставить его сюда.
# Если не задать — npm run bootstrap спросит его в терминале.
# API_TOKEN=
# Telegram id админов бота (см. ниже) — тоже можно не задавать здесь,
# bootstrap спросит и сохранит их в bootstrap-summary.json сам.
# ADMIN_TELEGRAM_IDS=
CONFIG_PROFILE_NAME=Default-Profile
REALITY_INBOUND_TAG=VLESS_REALITY
REALITY_PORT=443
REALITY_DEST=www.google.com:443
REALITY_SERVER_NAMES=www.google.com
INTERNAL_SQUAD_NAME=Default-Squad
OUT_FILE=./bootstrap-summary.json

# --- npm run add-node: регистрация новой ноды на панели ---
# API_TOKEN=              # можно не задавать, если рядом лежит bootstrap-summary.json
# BOOTSTRAP_SUMMARY_FILE=./bootstrap-summary.json
NODE_NAME=node-1
NODE_ADDRESS=203.0.113.10
NODE_CONTROL_PORT=2222
NODE_COUNTRY_CODE=XX

# --- npm run bot: сам Telegram-бот ---
BOT_TOKEN=123456:AA...                # от @BotFather
# API_TOKEN, ADMIN_TELEGRAM_IDS и INTERNAL_SQUAD_UUID можно не задавать,
# если рядом лежит bootstrap-summary.json — бот возьмёт их оттуда сам.
# API_TOKEN=
# ADMIN_TELEGRAM_IDS=
# INTERNAL_SQUAD_UUID=
TRIAL_DAYS=3
TRIAL_TRAFFIC_GB=10
DB_PATH=./data/bot.sqlite3
